# Referensi semua variabel. Cara termudah membuat .env: python scripts/make_env.py local
# File .env TIDAK boleh di-commit (sudah ada di .gitignore).

# --- Infrastruktur ---
# Saat memakai docker compose, host-nya adalah nama service (postgres, redis).
DATABASE_URL=postgresql+psycopg://policyguard:policyguard@postgres:5432/policyguard
REDIS_URL=redis://redis:6379/0
# API key untuk pemanggil API, dipisah koma. Ganti dengan string acak panjang.
SERVICE_API_KEYS=ganti-key-sistem-listing,ganti-key-dashboard
# Key yang dipakai dashboard; harus salah satu dari SERVICE_API_KEYS di atas.
DASHBOARD_API_KEY=ganti-key-dashboard

# --- Pipeline ---
# llm = sistem lengkap; rules_only = baseline tanpa AI (tidak butuh OPENAI_API_KEY)
PIPELINE_MODE=llm

# --- LLM ---
OPENAI_API_KEY=
# Cek nama model yang tersedia di dokumentasi OpenAI sebelum menjalankan.
LLM_MODEL=gpt-4o-mini
# Kosongkan jika model yang dipakai tidak menerima parameter temperature.
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# --- Retrieval ---
# topk = RAG; all = semua pasal dikirim ke LLM
RETRIEVAL_MODE=topk
RETRIEVAL_TOP_K=5
# openai atau local (local butuh requirements-local-embeddings.txt)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Threshold keputusan ---
# PLACEHOLDER. Tetapkan dari tabel "Simulasi threshold" hasil evaluasi dev set (ADR-008).
T_REJECT=0.8
T_APPROVE=0.8

LOG_LEVEL=INFO

# Image untuk deploy SATU service (Render free tier): API + dashboard dalam satu container.
# API hanya mendengarkan di 127.0.0.1 (tidak terbuka ke internet); dashboard di $PORT.
# Untuk docker compose lokal, pakai Dockerfile dan dashboard/Dockerfile (service terpisah).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt requirements-dashboard.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-dashboard.txt

COPY ai ./ai
COPY app ./app
COPY data ./data
COPY dashboard ./dashboard
COPY scripts ./scripts
COPY deploy ./deploy

# User non-root; diberi hak tulis ke /app karena database SQLite dibuat di sini.
RUN useradd --create-home appuser && chown -R appuser /app
USER appuser

EXPOSE 10000
CMD ["python", "deploy/render_start.py"]
